* linguist-detectable=false
*.py linguist-detectable=true linguist-language=Python

# Treat documentation, config, and data as non-code so language stats
# focus purely on Python source.
*.md linguist-documentation
docs/** linguist-documentation

*.yml linguist-documentation
*.yaml linguist-documentation

*.json linguist-data
*.csv linguist-data

*.svg linguist-generated
*.ico linguist-generated

# Make sure any shell / batch helpers or misc config are excluded too
*.bat linguist-generated
*.cmd linguist-generated
*.ps1 linguist-generated
Dockerfile linguist-generated
Makefile linguist-generated
.gitignore linguist-generated

.vscode/** linguist-generated
.github/** linguist-generated

